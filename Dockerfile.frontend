# Next.js standalone build. `output: "standalone"` in next.config.mjs is what makes the
# runtime stage possible — without it the whole node_modules tree has to ship.
FROM node:22-alpine AS deps
WORKDIR /app
# Cài thẳng pnpm thay vì qua corepack: corepack tự chọn bản mặc định của Node (9.x) trong
# khi lockfile do pnpm 10 sinh ra, và một số bản corepack còn vướng lỗi xác thực chữ ký
# registry ("Cannot find matching keyid"). Ghim số bản ở đây khớp với `packageManager`
# trong package.json.
RUN npm install -g pnpm@10.34.5
# pnpm-workspace.yaml phải đi cùng: pnpm 10 đọc `overrides` từ đó, và nếu thiếu nó thì
# lần cài này thấy "không có override" trong khi lockfile ghi là có → ERR_PNPM_LOCKFILE_CONFIG_MISMATCH.
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

FROM node:22-alpine AS build
WORKDIR /app
# Cài thẳng pnpm thay vì qua corepack: corepack tự chọn bản mặc định của Node (9.x) trong
# khi lockfile do pnpm 10 sinh ra, và một số bản corepack còn vướng lỗi xác thực chữ ký
# registry ("Cannot find matching keyid"). Ghim số bản ở đây khớp với `packageManager`
# trong package.json.
RUN npm install -g pnpm@10.34.5
COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ .

# NEXT_PUBLIC_* is inlined at build time, not read at runtime — so the API base URL has to
# be a build arg. Changing it means rebuilding the image, not just restarting it.
ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_TELEMETRY_DISABLED=1

RUN pnpm build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup -S nodejs && adduser -S nextjs -G nodejs

COPY --from=build /app/public ./public
COPY --from=build --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# 127.0.0.1 chứ KHÔNG phải localhost: Next standalone với HOSTNAME=0.0.0.0 chỉ nghe IPv4,
# trong khi /etc/hosts của Alpine có cả "::1 localhost" và busybox wget thử ::1 trước —
# connection refused, healthcheck fail vĩnh viễn dù ứng dụng chạy hoàn toàn bình thường.
# (Backend không dính vì JVM mặc định bind dual-stack.)
#
# KHÔNG nuốt stderr và KHÔNG thêm `|| exit 1`: bản trước làm cả hai, nên khi hỏng thì
# `docker inspect` chỉ hiện Output rỗng với ExitCode 1 — che mất cả thông báo lỗi lẫn
# exit code thật (127 "không có wget" bị đổi thành 1). Để nguyên thì lần sau nhìn là biết.
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=5 \
  CMD wget -q -O /dev/null http://127.0.0.1:3000

CMD ["node", "server.js"]
